# CPU + 8 GB RAM friendly defaults for Agent Lightning workflows

# ---------- CPU thread limits ----------
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
NUMEXPR_NUM_THREADS=2
TOKENIZERS_PARALLELISM=false

# ---------- Runtime behavior ----------
PYTHONUNBUFFERED=1
HF_HUB_DISABLE_TELEMETRY=1
TRANSFORMERS_NO_ADVISORY_WARNINGS=1

# ---------- Data / training safety ----------
ALIGHTNING_MAX_SEQ_LEN=512
ALIGHTNING_BATCH_SIZE=1
ALIGHTNING_MICRO_BATCH_SIZE=1
ALIGHTNING_GRAD_ACCUM_STEPS=8
ALIGHTNING_NUM_WORKERS=0
ALIGHTNING_EVAL_MAX_SAMPLES=128
ALIGHTNING_LOG_INTERVAL=10
ALIGHTNING_SAVE_INTERVAL=200

# ---------- llama.cpp style local inference ----------
ALIGHTNING_BACKEND=llama_cpp
ALIGHTNING_CTX_SIZE=2048
ALIGHTNING_N_BATCH=128
ALIGHTNING_N_THREADS=4
ALIGHTNING_N_GPU_LAYERS=0

# ---------- Memory allocator ----------
MALLOC_ARENA_MAX=2
